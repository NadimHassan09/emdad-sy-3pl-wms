# Staging Client SPA (staging-client.emdadsy.com) + same-origin /api, /realtime, /socket.io

server {
    listen 80;
    listen [::]:80;
    server_name staging-client.emdadsy.com;

    client_max_body_size 25m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging-client.emdadsy.com;

    ssl_certificate     /etc/nginx/ssl/emdad-wms-staging/staging.crt;
    ssl_certificate_key /etc/nginx/ssl/emdad-wms-staging/staging.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    include snippets/emdad-wms-staging-backend-locations.conf;

    root /var/www/emdad-sy-3pl-wms-staging/client-frontend/dist;
    index index.html;

    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    access_log /var/log/nginx/emdad-staging-client.access.log;
    error_log  /var/log/nginx/emdad-staging-client.error.log;
}
