{
  "name": "emdad-web-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Emdad WMS frontend V2 — self-contained; must never depend on the classic UI trees",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:admin": "npm run dev -w @emdad/admin",
    "dev:client": "npm run dev -w @emdad/client",
    "build:admin": "NODE_OPTIONS=--max-old-space-size=2048 npm run build -w @emdad/admin",
    "build:client": "NODE_OPTIONS=--max-old-space-size=2048 npm run build -w @emdad/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:independence": "node scripts/check-independence.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:routes": "node scripts/route-diff.mjs",
    "check": "npm run check:independence && npm run check:rtl && npm run check:contrast && npm run check:routes && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.59.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
