// ---------------------------------------------------------------------------

model Company {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  tradeName        String?          @map("trade_name")
  contactEmail     String           @map("contact_email")
  contactPhone     String?          @map("contact_phone")
  address          String?
  city             String?
  country          String           @default("SA")
  vatNumber        String?          @map("vat_number")
  billingCycle     BillingCycleType @default(monthly) @map("billing_cycle")
  paymentTermsDays Int              @default(30) @map("payment_terms_days")
  status           CompanyStatus    @default(active)
  notes            String?
  workflowUxSettings Json?            @map("workflow_ux_settings") @db.JsonB
  suspendedAt       DateTime?        @map("suspended_at") @db.Timestamptz(6)
  suspendedBy       String?          @map("suspended_by") @db.Uuid
  suspensionReason  String?          @map("suspension_reason")
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
  archivedBy        String?          @map("archived_by") @db.Uuid
  archiveReason     String?          @map("archive_reason")
  purgedAt          DateTime?        @map("purged_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  users          User[]
  products       Product[]
  inboundOrders  InboundOrder[]
  outboundOrders OutboundOrder[]
  returnOrders   ReturnOrder[]
  currentStock   CurrentStock[]
  ledgerEntries     InventoryLedger[]
  stockAdjustments       StockAdjustment[]
  cycleCountSchedules    CycleCountSchedule[]
  cycleCounts            CycleCount[]
  cycleCountVariances    CycleCountVariance[]
  cycleCountProductHistory CycleCountProductHistory[]
  workers                Worker[]
  workflowInstances      WorkflowInstance[]
  notifications          Notification[]
  userCompanyAccess      UserCompanyAccess[]
  billingPlans           BillingPlan[]
  billingCycles          BillingCycle[]
  invoices               Invoice[]
  orderManualCharges     OrderManualCharge[]
  documents              Document[]
  finalContracts         FinalContract[]
  stockReservations      StockReservation[]
  omsOrderEvents         OmsOrderEvent[]
  omsOrders              OmsOrder[]
  omsSalesChannels       OmsSalesChannel[]
  omsIntegrationEvents   OmsIntegrationEvent[]

  @@map("companies")
}

model BillingPlan {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  active                  Boolean  @default(true)
  cycleLengthDays         Int      @map("cycle_length_days")
  fixedSubscriptionFee    Decimal  @default(0) @map("fixed_subscription_fee") @db.Decimal(12, 2)
  inboundOrderFee         Decimal  @default(0) @map("inbound_order_fee") @db.Decimal(10, 4)
  outboundOrderFee        Decimal  @default(0) @map("outbound_order_fee") @db.Decimal(10, 4)
  outboundBaseFee         Decimal  @default(0) @map("outbound_base_fee") @db.Decimal(12, 2)
  outboundIncludedItems   Int      @default(0) @map("outbound_included_items")
  outboundAdditionalItemFee Decimal @default(0) @map("outbound_additional_item_fee") @db.Decimal(12, 2)
  packagingFee            Decimal  @default(0) @map("packaging_fee") @db.Decimal(10, 4)
  qualityCheckFee         Decimal  @default(0) @map("quality_check_fee") @db.Decimal(10, 4)
  excessVolumeFeePerDay   Decimal  @default(0) @map("excess_volume_fee_per_day") @db.Decimal(10, 4)
  excessWeightFeePerDay   Decimal  @default(0) @map("excess_weight_fee_per_day") @db.Decimal(10, 4)
  reservedVolume          Decimal  @default(0) @map("reserved_volume") @db.Decimal(14, 4)
  reservedWeight          Decimal  @default(0) @map("reserved_weight") @db.Decimal(14, 4)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id])
  billingCycles BillingCycle[]

  @@index([companyId], map: "idx_billing_plans_company")
  @@map("billing_plans")
}

model BillingCycle {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  billingPlanId String             @map("billing_plan_id") @db.Uuid
  startsAt      DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime           @map("ends_at") @db.Timestamptz(6)
  status        BillingCycleStatus @default(active)
  rateSnapshot  Json               @default("{}") @map("rate_snapshot") @db.JsonB
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id])
  billingPlan BillingPlan @relation(fields: [billingPlanId], references: [id])
  invoices    Invoice[]

  @@index([companyId, status], map: "idx_billing_cycles_company")
  @@map("billing_cycles")
}

model Invoice {
  id             String               @id @default(uuid()) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  billingCycleId String?              @map("billing_cycle_id") @db.Uuid
  invoiceSource  BillingInvoiceSource @default(cycle) @map("invoice_source")
  invoiceNumber  String               @unique @default("") @map("invoice_number")
  status         BillingInvoiceStatus @default(draft)
  subtotalAmount Decimal              @default(0) @map("subtotal_amount") @db.Decimal(14, 2)
  discountType   BillingDiscountType? @map("discount_type")
  discountValue  Decimal?             @map("discount_value") @db.Decimal(14, 4)
  discountAmount Decimal              @default(0) @map("discount_amount") @db.Decimal(14, 2)
  vatPercentage  Decimal              @default(0) @map("vat_percentage") @db.Decimal(8, 4)
  vatAmount      Decimal              @default(0) @map("vat_amount") @db.Decimal(14, 2)
  grandTotal     Decimal              @default(0) @map("grand_total") @db.Decimal(14, 2)
  totalAmount    Decimal              @default(0) @map("total_amount") @db.Decimal(14, 2)
  issuedAt       DateTime?            @map("issued_at") @db.Timestamptz(6)
  dueDate        DateTime?            @map("due_date") @db.Date
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id])
  billingCycle BillingCycle? @relation(fields: [billingCycleId], references: [id])
  lines        InvoiceLine[]

  @@index([companyId], map: "idx_invoices_company")
  @@index([billingCycleId], map: "idx_invoices_cycle")
  @@map("invoices")
}

model InvoiceLine {
  id            String                   @id @default(uuid()) @db.Uuid
  invoiceId     String                   @map("invoice_id") @db.Uuid
  type          BillingInvoiceLineType
  lineSource    BillingInvoiceLineSource @default(system) @map("line_source")
  description   String?
  quantity      Decimal                  @db.Decimal(15, 4)
  unitPrice     Decimal                  @map("unit_price") @db.Decimal(10, 4)
  totalPrice    Decimal                  @map("total_price") @db.Decimal(14, 2)
  orderChargeId String?                  @map("order_charge_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_invoice_lines_invoice")
  @@index([invoiceId, lineSource], map: "idx_invoice_lines_source")
  @@map("invoice_lines")
}

model OrderManualCharge {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id") @db.Uuid
  description   String
  quantity      Decimal  @default(1) @db.Decimal(15, 4)
  unitPrice     Decimal  @default(0) @map("unit_price") @db.Decimal(12, 4)
  totalPrice    Decimal  @default(0) @map("total_price") @db.Decimal(14, 2)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([referenceType, referenceId], map: "idx_order_manual_charges_ref")
  @@index([companyId], map: "idx_order_manual_charges_company")
  @@map("order_manual_charges")
}

enum DocumentType {
  grn
  delivery_note
  final_contract

  @@map("document_type")
}

/// Immutable generated PDF documents (GRN / Delivery Note). One row per
/// (type, source task, language). Files are written once and never mutated.
model Document {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  type           DocumentType
  /// 'inbound_order' | 'outbound_order'
  referenceType  String       @map("reference_type")
  referenceId    String       @map("reference_id") @db.Uuid
  /// Source warehouse task that triggered generation (receiving / dispatch).
  taskId         String?      @map("task_id") @db.Uuid
  documentNumber String       @map("document_number")
  fileName       String       @map("file_name")
  filePath       String       @map("file_path")
  language       String       @default("en")
  hash           String
  fileSize       Int          @default(0) @map("file_size")
  generatedBy    String?      @map("generated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([type, taskId, language], map: "uq_document_task_lang")
  @@index([companyId, type], map: "idx_documents_company_type")
  @@index([referenceType, referenceId], map: "idx_documents_reference")
  @@map("documents")
}

/// 3PL warehouse service agreement between provider and client.
model FinalContract {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  contractNumber         String   @unique @map("contract_number")
  issueDate              DateTime @map("issue_date") @db.Date
  clientCompanyName      String   @map("client_company_name")
  clientCompanyType      String?  @map("client_company_type")
  clientAddress          String?  @map("client_address")
  clientPhone            String?  @map("client_phone")
  clientEmail            String?  @map("client_email")
  clientTaxId            String?  @map("client_tax_id")
  clientSignatoryName    String?  @map("client_signatory_name")
  clientSignatoryTitle   String?  @map("client_signatory_title")
  rateStorage            Decimal  @map("rate_storage") @db.Decimal(12, 2)
  rateInboundHandling    Decimal  @map("rate_inbound_handling") @db.Decimal(12, 2)
  rateOutboundHandling   Decimal  @map("rate_outbound_handling") @db.Decimal(12, 2)
  rateValueAddedServices  Decimal  @map("rate_value_added_services") @db.Decimal(12, 2)
  rateReturnProcessing   Decimal  @map("rate_return_processing") @db.Decimal(12, 2)
  createdBy              String?  @map("created_by") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "idx_final_contracts_company")
  @@index([issueDate], map: "idx_final_contracts_issue_date")
  @@map("final_contracts")
}

/// Per-task overrides for GRN / DN PDF fields (editable from the contracts catalog).
model DocumentSlotOverride {
  taskId          String   @id @map("task_id") @db.Uuid
  clientReference String?  @map("client_reference")
  notes           String?
  supplier        String?
  poNumber        String?  @map("po_number")
  operatorName    String?  @map("operator_name")
  destination     String?
  carrier         String?
  trackingNumber  String?  @map("tracking_number")
  vehicle         String?
  driver          String?
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("document_slot_overrides")
}

/// Explicit internal-user grants to operate on a 3PL client tenant (Phase 1.1).
model UserCompanyAccess {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_company_access")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String?    @map("company_id") @db.Uuid
  email         String     @unique
  passwordHash  String     @map("password_hash")
  fullName      String     @map("full_name")
  phone         String?
  role          UserRole
  status        UserStatus @default(active)
  tokenVersion  Int        @default(0) @map("token_version")
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  company             Company?         @relation(fields: [companyId], references: [id])
  inboundOrdersOwned           InboundOrder[]           @relation("InboundCreatedBy")
  outboundOrdersOwned          OutboundOrder[]          @relation("OutboundCreatedBy")
  returnOrdersOwned            ReturnOrder[]            @relation("ReturnCreatedBy")
  returnOrdersCancelled        ReturnOrder[]            @relation("ReturnCancelledBy")
  ledgerEntries                InventoryLedger[]
  stockAdjustmentsCreated      StockAdjustment[]        @relation("AdjustmentCreatedBy")
  stockAdjustmentsApproved     StockAdjustment[]        @relation("AdjustmentApprovedBy")
  worker                  Worker?
  taskAssignmentsAssigned TaskAssignment[]           @relation("TaskAssignedBy")
  taskEvents              TaskEvent[]                @relation("TaskEventActor")
  warehouseTasksCompleted WarehouseTask[]            @relation("WarehouseTaskCompleter")
  notifications           Notification[]
  companyAccess           UserCompanyAccess[]
  authRefreshSessions     AuthRefreshSession[]
  cycleCountSchedulesCreated CycleCountSchedule[] @relation("CycleCountScheduleCreator")
  cycleCountsCreated         CycleCount[]         @relation("CycleCountCreator")
  cycleCountLinesCounted     CycleCountLine[]     @relation("CycleCountLineCounter")
  cycleCountVariancesReviewed CycleCountVariance[] @relation("CycleCountVarianceReviewer")
  returnLinesInspected        ReturnOrderLine[]    @relation("ReturnLineInspector")
  backupJobsTriggered         BackupJob[]          @relation("BackupTriggeredBy")
  backupSchedulesCreated      BackupSchedule[]     @relation("BackupScheduleCreatedBy")
  backupSchedulesUpdated      BackupSchedule[]     @relation("BackupScheduleUpdatedBy")
  backupDriveIntegrations     BackupDriveIntegration[] @relation("BackupDriveConnectedBy")
  backupStorageSettingsUpdated BackupStorageSettings[] @relation("BackupStorageSettingsUpdatedBy")
  omsOrderEventsCreated      OmsOrderEvent[]          @relation("OmsOrderEventCreatedBy")
  omsOrdersOwned             OmsOrder[]               @relation("OmsOrderCreatedBy")
  omsOrdersCancelled         OmsOrder[]               @relation("OmsOrderCancelledBy")
  omsOrdersApproved          OmsOrder[]               @relation("OmsOrderApprovedBy")
  omsOrdersRejected          OmsOrder[]               @relation("OmsOrderRejectedBy")

  @@map("users")
}

model BackupStorageSettings {
  id               String              @id @default("00000000-0000-4000-8000-0000000000d1") @db.Uuid
  defaultPolicy    BackupStoragePolicy @default(local_and_drive) @map("default_policy")
  updatedByUserId  String?             @map("updated_by_user_id") @db.Uuid
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("BackupStorageSettingsUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("backup_storage_settings")
}

model BackupSchedule {
  id             String                  @id @default(uuid()) @db.Uuid
  enabled        Boolean                 @default(true)
  frequency      BackupScheduleFrequency
  hour           Int                     @db.SmallInt
  minute         Int                     @db.SmallInt
  retentionDays  Int                     @default(7) @map("retention_days")
  storagePolicy  BackupStoragePolicy?    @map("storage_policy")
  lastRunAt      DateTime?               @map("last_run_at") @db.Timestamptz(6)
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  updatedByUserId String                 @map("updated_by_user_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User        @relation("BackupScheduleCreatedBy", fields: [createdByUserId], references: [id])
