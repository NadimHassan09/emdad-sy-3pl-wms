{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "pdf/templates/**/*", "outDir": "dist/src", "watchAssets": true },
      { "include": "pdf/styles/**/*", "outDir": "dist/src", "watchAssets": true },
      { "include": "pdf/assets/**/*", "outDir": "dist/src", "watchAssets": true }
    ]
  }
}
