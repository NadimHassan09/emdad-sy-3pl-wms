{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "paths": {
      "@ds": ["../shared/design-system-next/ui/index.ts"],
      "@ds/*": ["../shared/design-system-next/ui/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"]
    }
  },
  "include": [
    "src",
    "../shared/design-system-next/ui/**/*.ts",
    "../shared/design-system-next/ui/**/*.tsx",
    "../shared/design-system-next/lib/**/*.ts",
    "../shared/design-system-next/hooks/**/*.ts"
  ]
}
