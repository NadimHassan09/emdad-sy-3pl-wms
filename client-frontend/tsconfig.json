{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@ds": ["../shared/design-system-next/ui/index.ts"],
      "@ds/*": ["../shared/design-system-next/ui/*"],
      "@ds/hooks/*": ["../shared/design-system-next/hooks/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"]
    }
  },
  "include": [
    "src",
    "../shared/design-system-next/ui/**/*.ts",
    "../shared/design-system-next/ui/**/*.tsx",
    "../shared/design-system-next/lib/**/*.ts",
    "../shared/design-system-next/hooks/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.unit.spec.ts",
    "../shared/design-system-next/**/*.spec.ts",
    "../shared/design-system-next/**/*.unit.spec.ts"
  ]
}
